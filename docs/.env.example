# =========================================================

# StudyGen-AI Environment Variables

# =========================================================

#

# This file documents the environment variables required

# by the current StudyGen-AI implementation.

#

# IMPORTANT:

# - Never commit real secrets.

# - Copy the required values into local .env files.

# - Do not expose GEMINI_API_KEY through VITE_* variables.

# =========================================================

# =========================================================

# BACKEND

# =========================================================

# Google Gemini API key used by the FastAPI AI service.

#

# Required by:

# backend/services/ai_service.py

#

# NEVER expose this value to the frontend.

GEMINI_API_KEY=your_gemini_api_key_here

# Frontend origin allowed by FastAPI CORS.

#

# Used by:

# backend/main.py

FRONTEND_URL=http://localhost:5173

# SQLite ownership/session database path. Relative paths resolve from backend/.
STUDYGEN_DATABASE_PATH=./data/studygen.sqlite3

# Keep false only for local HTTP development. Use true for HTTPS deployments.
SESSION_COOKIE_SECURE=false

# Use "none" only for cross-site frontend/API deployments, and only with secure=true.
SESSION_COOKIE_SAMESITE=lax

# =========================================================

# FRONTEND

# =========================================================

# URL of the StudyGen FastAPI backend.

#

# Used by:

# frontend/src/pages/AITutor.jsx

# frontend/src/pages/Documents.jsx

#

# Vite exposes variables beginning with VITE_ to the

# frontend, so this variable MUST NOT contain secrets.

VITE_API_URL=http://localhost:8000

# =========================================================

# CURRENTLY HARD-CODED APPLICATION SETTINGS

# =========================================================

#

# The following values are intentionally NOT listed as

# environment variables because the current implementation

# does not read them from the environment.

#

# Document upload limit: 20 MB

# AI Tutor question limit: 4000 characters

# AI Tutor history limit: 20 messages

# AI Tutor rate limit: 20 requests / 60 seconds

#

# If these values become configurable in the future,

# the backend implementation and this file should be

# updated together.

# =========================================================
