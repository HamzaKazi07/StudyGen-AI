# ==============================
# StudyGen-AI Git Ignore
# ==============================

# Graft generated context graph
/graft/

# ==============================
# Environment / Secrets
# ==============================
.env
.env.*
!.env.example

# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==============================
# Backend runtime/generated data
# ==============================
backend/uploads/*
!backend/uploads/.gitkeep

backend/*.db
backend/*.sqlite
backend/*.sqlite3

# ==============================
# Frontend / Node
# ==============================
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Vite
dist/
.vite/
.vite-temp/

# ==============================
# Build output
# ==============================
build/
out/

# ==============================
# IDE / Editor
# ==============================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.iml

# ==============================
# OS files
# ==============================
.DS_Store
Thumbs.db
desktop.ini

# ==============================
# Logs
# ==============================
*.log

# ==============================
# Temporary files
# ==============================
*.tmp
*.temp
*.bak
